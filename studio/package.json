{
  "name": "@alien6/hankoshell-theme-studio",
  "version": "0.1.0-preview.6",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Visual identity theme studio and reusable theme catalogue for Hanko and standalone applications",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/studio.css",
    "./contracts": {
      "types": "./dist/contracts.d.cts",
      "require": "./dist/contracts.cjs",
      "default": "./dist/contracts.cjs"
    },
    "./catalog": "./dist/catalog.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "vite --config vite.config.mjs",
    "test": "node --test test/*.test.mjs",
    "typecheck": "npm run contracts:generate && tsc --noEmit",
    "test:browser": "node test/browser.mjs",
    "contracts:generate": "node scripts/contracts.mjs",
    "build:site": "npm run build && vite build",
    "sitemap": "node scripts/sitemap.mjs",
    "test:publication": "node test/publication.mjs",
    "test:dashboard": "node test/dashboard-host.mjs",
    "package:preview": "npm run build:site && node scripts/package-preview.mjs"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "^22.0.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "0.25.12",
    "lucide-react": "^0.469.0",
    "otpauth": "9.5.2",
    "postcss": "8.5.32",
    "postcss-selector-parser": "7.1.7",
    "qrcode": "1.5.4",
    "radix-ui": "^1.6.7",
    "tailwindcss": "4.1.18",
    "typescript": "^5.7.3",
    "vite": "6.4.5"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alien6-Studio/hankoshell-keycloak-theme-builder.git",
    "directory": "studio"
  },
  "homepage": "https://github.com/Alien6-Studio/hankoshell-keycloak-theme-builder/tree/main/studio",
  "bugs": {
    "url": "https://github.com/Alien6-Studio/hankoshell-keycloak-theme-builder/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "preview"
  },
  "keywords": [
    "keycloak",
    "keycloakify",
    "theme-builder",
    "visual-editor",
    "react",
    "identity",
    "shadcn-ui"
  ]
}
