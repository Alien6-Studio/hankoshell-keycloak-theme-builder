{
  "name": "@alien6/hankoshell-keycloak-theme-kit",
  "version": "0.1.0",
  "description": "Shared Keycloak login renderer, live branding preview and Keycloakify theme builder",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alien6-Studio/hankoshell-keycloak-theme-kit.git"
  },
  "homepage": "https://github.com/Alien6-Studio/hankoshell-keycloak-theme-kit",
  "bugs": {
    "url": "https://github.com/Alien6-Studio/hankoshell-keycloak-theme-kit/issues"
  },
  "bin": {
    "hanko-theme": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./keycloak": {
      "types": "./dist/keycloak.d.ts",
      "import": "./dist/keycloak.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node --input-type=module -e \"import {rmSync} from 'node:fs'; rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "check": "npm run build && node --test test/*.test.mjs && npm pack --dry-run",
    "test:browser": "node test/browser.mjs",
    "test:keycloak": "node test/keycloak.mjs",
    "dev": "node dist/cli.js dev examples/aurora/theme.json"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "keycloakify": "^11.15.3",
    "vite": "6.4.5"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright": "^1.60.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.7.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
